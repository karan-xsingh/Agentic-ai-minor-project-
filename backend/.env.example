# Copy this file to ".env" (same folder) and put your real key in it.
# The .env file is private: never share it or upload it to GitHub.

LLM_PROVIDER=groq
GROQ_API_KEY=paste-your-key-here
LLM_MODEL=openai/gpt-oss-120b

